# This file is a contract only. Copy it to a secret-managed location and replace
# every angle-bracket placeholder before validation. Never commit the rendered file.
APP_ENV="staging"
STAGING_MODE="<local-or-managed>"
NODE_ENV="production"
APP_BASE_URL="<https-staging-origin>"
AUTH_PUBLIC_ORIGIN="<https-staging-origin>"
APP_URL="<https-staging-origin>"

DATABASE_URL="<postgresql-staging-url>"
DATABASE_APPLICATION_NAME="avantime-staging-web"
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT_SECONDS="10"
DATABASE_STATEMENT_TIMEOUT_MS="30000"
DATABASE_TRANSACTION_TIMEOUT_MS="30000"

REDIS_URL="<authenticated-staging-redis-url>"
REDIS_NAMESPACE="avantime:staging:<deployment>"
REDIS_REQUIRED_FOR_READINESS="true"
REDIS_CONNECT_TIMEOUT_MS="3000"
REDIS_DEFAULT_TTL_SECONDS="900"

OBJECT_STORAGE_ENDPOINT="<https-staging-s3-endpoint>"
OBJECT_STORAGE_REGION="<region>"
OBJECT_STORAGE_BUCKET="<private-staging-bucket>"
OBJECT_STORAGE_ACCESS_KEY="<secret-store-reference>"
OBJECT_STORAGE_SECRET_KEY="<secret-store-reference>"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"
OBJECT_STORAGE_MAX_BYTES="20971520"
OBJECT_STORAGE_RETENTION_DAYS="7"

NOTIFICATION_PROVIDER_MODE="<test-or-resend>"
NOTIFICATION_SENDER_IDENTITY="<verified-staging-sender>"
NOTIFICATION_MAX_ATTEMPTS="5"
NOTIFICATION_BATCH_SIZE="20"
NOTIFICATION_LEASE_MS="60000"
NOTIFICATION_WORKER_ID="notification-staging-1"
RESEND_API_KEY="<secret-store-reference>"

KNOWLEDGE_CACHE_DRIVER="redis"
KNOWLEDGE_SEARCH_DRIVER="postgresql"
KNOWLEDGE_VECTOR_DRIVER="pgvector"
KNOWLEDGE_EMBEDDING_MODEL="<embedding-model>"
KNOWLEDGE_EMBEDDING_VERSION="<embedding-version>"
KNOWLEDGE_INDEX_WORKER_ID="knowledge-staging-1"

SESSION_SECRET="<secret-store-reference>"
MFA_ENCRYPTION_KEY="<secret-store-reference>"
MFA_ENCRYPTION_KEY_VERSION="v1"
AUDIT_INTEGRITY_KEY="<secret-store-reference>"
AUTH_ADMIN_MFA_REQUIRED="true"
OIDC_ALLOWED_HOSTS="<provider-hosts>"

APP_VERSION="<immutable-version>"
COMMIT_SHA="<git-commit-sha>"
MIGRATION_VERSION="20260803180000_jira_status_comment_sync"
DEPLOYMENT_GENERATION="<deployment-generation>"

BACKUP_DESTINATION_REFERENCE="<external-backup-destination-reference>"
BACKUP_DRIVER="s3"
BACKUP_STORAGE_ENDPOINT="<https-backup-storage-endpoint>"
BACKUP_OBJECT_STORAGE_BUCKET="<private-staging-backup-bucket>"
BACKUP_RETENTION_DAYS="14"
BACKUP_ENVIRONMENT="staging"
BACKUP_ENCRYPTION_REQUIRED="true"
BACKUP_ENCRYPTION_KEY="<secret-store-reference>"
BACKUP_CONFIRMATION="BACKUP:staging"
OTEL_SERVICE_NAME="avantime-staging"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=staging"

JIRA_INTEGRATION_ENABLED="<true-or-false>"
JIRA_MODE="<disabled-test-or-cloud>"
JIRA_BASE_URL="<https-jira-cloud-origin>"
JIRA_PROJECT_KEY="<jira-project-key>"
JIRA_ISSUE_TYPE="<jira-issue-type>"
JIRA_EMAIL="<service-account-identifier>"
JIRA_API_TOKEN="<secret-store-reference>"
JIRA_REQUEST_TIMEOUT_MS="10000"
JIRA_MAX_ATTEMPTS="5"
JIRA_BATCH_SIZE="20"
JIRA_LEASE_MS="60000"
JIRA_POLL_INTERVAL_MS="1000"
JIRA_WORKER_ID="jira-staging-1"
JIRA_WEBHOOK_MODE="<disabled-test-or-cloud>"
JIRA_WEBHOOK_SECRET="<secret-store-reference>"
JIRA_WEBHOOK_ALLOWED_ORIGIN="<https-jira-cloud-origin>"
JIRA_WEBHOOK_TIMEOUT_MS="5000"
JIRA_WEBHOOK_REPLAY_WINDOW_MS="300000"
JIRA_WEBHOOK_MAX_PAYLOAD_BYTES="262144"
JIRA_WEBHOOK_ENABLED_EVENTS="jira:issue_updated,jira:issue_deleted,comment_created,comment_updated"
JIRA_INBOUND_MAX_ATTEMPTS="5"
JIRA_INBOUND_BATCH_SIZE="20"
JIRA_INBOUND_LEASE_MS="60000"
JIRA_INBOUND_POLL_INTERVAL_MS="1000"
JIRA_INBOUND_RETENTION_DAYS="30"
JIRA_INBOUND_WORKER_ID="jira-inbound-staging-1"

# Existing document/RAG contracts remain required by the web and index worker.
DOCUMENT_STORAGE_DRIVER="s3"
DOCUMENT_METADATA_DRIVER="postgresql"
DOCUMENT_PROCESSING_QUEUE_DRIVER="external"
DOCUMENT_PROCESSING_QUEUE_NAME="staging-<deployment>-document"
DOCUMENT_WORKER_TENANT_ID="staging-system"
DOCUMENT_WORKER_ID="document-staging-1"
WORKER_VERSION="<immutable-version>"
DOCUMENT_OCR_DRIVER="local"
DOCUMENT_OCR_REQUIRED_FOR_READINESS="true"
DOCUMENT_EMBEDDING_DRIVER="<openai-or-gemini>"
DOCUMENT_EMBEDDING_QUEUE_DRIVER="redis"
DOCUMENT_VECTOR_DRIVER="pgvector"
DOCUMENT_RAG_REQUIRED_FOR_READINESS="true"
RAG_ANSWER_DRIVER="<openai-or-gemini>"
AI_RATE_LIMIT_DRIVER="redis"
AI_COST_LEDGER_DRIVER="postgresql"
