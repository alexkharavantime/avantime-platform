# Static schema example only. It is intentionally non-deployable.
# Copy to a protected .env.staging outside version control and replace every <...>.
DEPLOYMENT_ENVIRONMENT="staging"
STAGING_ENVIRONMENT_ID="staging-<environment-id>"
STAGING_LABEL="staging <region-or-purpose>"
STAGING_TENANT_ALLOWLIST="staging-tenant-en,staging-tenant-lv,staging-tenant-ru"
STAGING_TLS_HOSTNAME="<staging-hostname.example>"
STAGING_FORBIDDEN_PRODUCTION_HOSTS="<production-hostname.example>"
STAGING_ALLOW_INTERNAL_PLAINTEXT="false"

STAGING_SECRETS_SOURCE="file"
STAGING_SECRETS_MOUNT="/run/secrets"
STAGING_SECRET_MAXIMUM_AGE_DAYS="90"
SESSION_SECRET_FILE="/run/secrets/session_secret"
DATABASE_URL_FILE="/run/secrets/database_url"
REDIS_URL_FILE="/run/secrets/redis_url"
OBJECT_STORAGE_ACCESS_KEY_FILE="/run/secrets/object_storage_access_key"
OBJECT_STORAGE_SECRET_KEY_FILE="/run/secrets/object_storage_secret_key"
BACKUP_ENCRYPTION_KEY_FILE="/run/secrets/backup_encryption_key"
AUDIT_INTEGRITY_KEY_FILE="/run/secrets/audit_integrity_key"

APP_URL="https://<staging-hostname.example>"
DATABASE_URL="postgresql://<staging-user>:<secret>@<staging-db.example>/<staging-db>?sslmode=verify-full"
REDIS_URL="rediss://<staging-user>:<secret>@<staging-redis.example>/0"

DOCUMENT_STORAGE_DRIVER="s3"
DOCUMENT_METADATA_DRIVER="postgresql"
DOCUMENT_PROCESSING_QUEUE_DRIVER="external"
DOCUMENT_PROCESSING_QUEUE_NAME="staging-document-processing"
DOCUMENT_PROCESSING_MAX_ATTEMPTS="3"
DOCUMENT_PROCESSING_INITIAL_RETRY_MS="1000"
DOCUMENT_PROCESSING_MAX_RETRY_MS="60000"
DOCUMENT_PROCESSING_LEASE_MS="300000"
DOCUMENT_PROCESSING_POLL_MS="1000"
DOCUMENT_WORKER_TENANT_ID="staging-tenant-en"
DOCUMENT_WORKER_ID="staging-document-worker-1"
WORKER_VERSION="task-006"
DEPLOYMENT_GENERATION="<release-digest>"

DOCUMENT_OCR_DRIVER="local"
DOCUMENT_OCR_REQUIRED_FOR_READINESS="true"
DOCUMENT_OCR_LANGUAGES="eng,lav,rus"
DOCUMENT_OCR_TIMEOUT_MS="120000"
DOCUMENT_OCR_MAX_PAGES="50"
DOCUMENT_OCR_MAX_FILE_SIZE="20971520"

OBJECT_STORAGE_ENDPOINT="https://<staging-object-storage.example>"
OBJECT_STORAGE_REGION="eu-central-1"
OBJECT_STORAGE_BUCKET="avantime-staging-documents"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

STAGING_PROVIDER_MODE="fake"
STAGING_ALLOW_FAKE_PROVIDER="true"
DOCUMENT_EMBEDDING_DRIVER="fake"
DOCUMENT_EMBEDDING_MODEL="deterministic-staging-v1"
DOCUMENT_EMBEDDING_DIMENSIONS="32"
DOCUMENT_EMBEDDING_VERSION="staging-v1"
DOCUMENT_EMBEDDING_BATCH_SIZE="16"
DOCUMENT_EMBEDDING_TIMEOUT_MS="30000"
DOCUMENT_EMBEDDING_MAX_ATTEMPTS="3"
DOCUMENT_EMBEDDING_INITIAL_RETRY_MS="1000"
DOCUMENT_EMBEDDING_MAX_RETRY_MS="60000"
DOCUMENT_EMBEDDING_QUEUE_DRIVER="redis"
DOCUMENT_EMBEDDING_LEASE_MS="300000"
DOCUMENT_EMBEDDING_POLL_MS="1000"
DOCUMENT_VECTOR_DRIVER="pgvector"
RAG_ANSWER_DRIVER="fake"
RAG_ANSWER_MODEL="deterministic-answer-staging-v1"
RAG_MAX_CONTEXT_CHARACTERS="18000"
RAG_MAX_OUTPUT_TOKENS="1000"
RAG_TIMEOUT_MS="45000"
RAG_QUERY_MAX_CHARACTERS="2000"
DOCUMENT_RAG_REQUIRED_FOR_READINESS="true"
OPENAI_BASE_URL="https://api.openai.com"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

AI_RATE_LIMIT_DRIVER="redis"
AI_COST_LEDGER_DRIVER="postgresql"
AI_RATE_LIMIT_PER_MINUTE="30"
AI_RATE_LIMIT_PER_DAY="5000"
AI_RATE_LIMIT_BURST="10"
AI_DAILY_BUDGET_EUR="5"
AI_MONTHLY_BUDGET_EUR="50"

BACKUP_DRIVER="s3"
BACKUP_ENVIRONMENT="<same-as-staging-environment-id>"
BACKUP_STORAGE_ENDPOINT="https://<staging-backup-storage.example>"
BACKUP_OBJECT_STORAGE_BUCKET="avantime-staging-backups"
BACKUP_OBJECT_STORAGE_SSE="AES256"
BACKUP_OUTPUT_DIR="/var/lib/avantime-backups"
BACKUP_ENCRYPTION_REQUIRED="true"

OTEL_EXPORTER_OTLP_ENDPOINT="https://<staging-otel-collector.example>"
STAGING_ALERT_DESTINATION="https://<staging-alert-endpoint.example>/hooks/avantime"
STAGING_ALERT_ADAPTER="noop"
STAGING_TLS_EXPIRY_WARNING_DAYS="30"
STAGING_TLS_EXPIRY_MINIMUM_DAYS="7"
