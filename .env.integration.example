# Local/integration use only. Never reuse these credentials in production.
NODE_ENV="test"
RUN_DOCUMENT_INTEGRATION_TESTS="1"

POSTGRES_USER="avantime_test"
POSTGRES_PASSWORD="avantime_test_only"
POSTGRES_DB="avantime_integration"
POSTGRES_PORT="55432"
DATABASE_URL="postgresql://avantime_test:avantime_test_only@127.0.0.1:55432/avantime_integration?schema=public"
RESTORE_POSTGRES_PORT="55433"
RESTORE_DATABASE_URL="postgresql://avantime_test:avantime_test_only@127.0.0.1:55433/avantime_restore_rehearsal?schema=public"
RESTORE_REHEARSAL_ALLOWED="true"
RESTORE_CONFIRMATION="RESTORE:avantime_restore_rehearsal"

REDIS_PORT="56379"
REDIS_PASSWORD="avantime_redis_test_only"
REDIS_URL="redis://:avantime_redis_test_only@127.0.0.1:56379/0"

MINIO_ROOT_USER="avantime_test"
MINIO_ROOT_PASSWORD="avantime_test_only_123"
MINIO_PORT="59000"
MINIO_CONSOLE_PORT="59001"
MINIO_BUCKET="avantime-documents-integration"
MINIO_BACKUP_BUCKET="avantime-backups-integration"

OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:59000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_BUCKET="avantime-documents-integration"
OBJECT_STORAGE_ACCESS_KEY="avantime_test"
OBJECT_STORAGE_SECRET_KEY="avantime_test_only_123"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

DOCUMENT_STORAGE_DRIVER="s3"
DOCUMENT_METADATA_DRIVER="postgresql"
DOCUMENT_PROCESSING_QUEUE_DRIVER="local"
DOCUMENT_DATA_DIR=".data/integration"
DOCUMENT_PROCESSING_MAX_ATTEMPTS="3"
DOCUMENT_PROCESSING_INITIAL_RETRY_MS="50"
DOCUMENT_PROCESSING_MAX_RETRY_MS="200"
DOCUMENT_PROCESSING_LEASE_MS="5000"
DOCUMENT_PROCESSING_POLL_MS="50"
DOCUMENT_WORKER_TENANT_ID="integration-worker"
DOCUMENT_WORKER_ID="integration-worker-1"
WORKER_VERSION="task-005-integration"
DEPLOYMENT_GENERATION="integration-1"
DOCUMENT_OCR_DRIVER="disabled"
DOCUMENT_OCR_REQUIRED_FOR_READINESS="false"
DOCUMENT_OCR_LANGUAGES="eng"
DOCUMENT_OCR_TIMEOUT_MS="30000"
DOCUMENT_OCR_MAX_PAGES="10"
DOCUMENT_OCR_MAX_FILE_SIZE="5242880"
DOCUMENT_TEXT_MIN_CHARACTERS="40"
DOCUMENT_TEXT_MIN_PRINTABLE_RATIO="0.90"
DOCUMENT_TEXT_MIN_ALPHANUMERIC_RATIO="0.20"
DOCUMENT_DETECTION_MIN_CONFIDENCE="0.70"
DOCUMENT_INTELLIGENCE_VERSION="document-intelligence-integration-v1"

DOCUMENT_EMBEDDING_DRIVER="fake"
DOCUMENT_EMBEDDING_MODEL="deterministic-hash-integration-v1"
DOCUMENT_EMBEDDING_DIMENSIONS="32"
DOCUMENT_EMBEDDING_VERSION="embedding-integration-v1"
DOCUMENT_EMBEDDING_BATCH_SIZE="8"
DOCUMENT_EMBEDDING_TIMEOUT_MS="5000"
DOCUMENT_EMBEDDING_MAX_ATTEMPTS="3"
DOCUMENT_EMBEDDING_INITIAL_RETRY_MS="50"
DOCUMENT_EMBEDDING_MAX_RETRY_MS="200"
DOCUMENT_EMBEDDING_QUEUE_DRIVER="postgresql"
DOCUMENT_EMBEDDING_LEASE_MS="5000"
DOCUMENT_EMBEDDING_POLL_MS="50"
DOCUMENT_VECTOR_DRIVER="pgvector"
HYBRID_LEXICAL_WEIGHT="0.45"
HYBRID_SEMANTIC_WEIGHT="0.55"
HYBRID_TOP_K="12"
HYBRID_MAX_CHUNKS_PER_DOCUMENT="3"
HYBRID_MIN_SCORE="0.20"
SEMANTIC_SIMILARITY_THRESHOLD="0.10"
RAG_ANSWER_DRIVER="fake"
RAG_ANSWER_MODEL="deterministic-answer-integration-v1"
RAG_MAX_CONTEXT_CHARACTERS="12000"
RAG_MAX_OUTPUT_TOKENS="500"
RAG_TIMEOUT_MS="5000"
RAG_QUERY_MAX_CHARACTERS="2000"
AI_RATE_LIMIT_PER_MINUTE="1000"
AI_RATE_LIMIT_PER_DAY="10000"
AI_RATE_LIMIT_BURST="100"
AI_DAILY_BUDGET_EUR="0"
AI_MONTHLY_BUDGET_EUR="0"
DOCUMENT_RAG_REQUIRED_FOR_READINESS="true"

BACKUP_ENVIRONMENT="integration"
BACKUP_OUTPUT_DIR="/tmp/avantime-integration-backups"
BACKUP_ENCRYPTION_REQUIRED="true"
BACKUP_CONFIRMATION="BACKUP:integration"
BACKUP_OBJECT_STORAGE_BUCKET="avantime-backups-integration"
BACKUP_OBJECT_STORAGE_SSE="none"
PGVECTOR_LOAD_TEST_ALLOWED="true"

JIRA_WEBHOOK_MODE="test"
JIRA_WEBHOOK_SECRET="integration-test-webhook-secret-at-least-32-characters"
JIRA_WEBHOOK_ALLOWED_ORIGIN="https://jira.test.invalid"
JIRA_WEBHOOK_TIMEOUT_MS="5000"
JIRA_WEBHOOK_REPLAY_WINDOW_MS="300000"
JIRA_WEBHOOK_MAX_PAYLOAD_BYTES="262144"
JIRA_WEBHOOK_ENABLED_EVENTS="jira:issue_updated,jira:issue_deleted,comment_created,comment_updated"
JIRA_INBOUND_MAX_ATTEMPTS="3"
JIRA_INBOUND_BATCH_SIZE="10"
JIRA_INBOUND_LEASE_MS="5000"
JIRA_INBOUND_POLL_INTERVAL_MS="250"
JIRA_INBOUND_RETENTION_DAYS="30"
JIRA_INBOUND_WORKER_ID="jira-inbound-integration-1"
