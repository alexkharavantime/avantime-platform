# Required in every environment. Generate a unique value with at least 32 characters.
SESSION_SECRET=""

# Optional local-only demo login. It is always disabled in production.
ENABLE_DEMO_AUTH="false"

# PostgreSQL. Required for document metadata in production.
DATABASE_URL="postgresql://avantime:avantime@localhost:5432/avantime?schema=public"

# Jira Cloud. Leave credentials empty to run without Jira synchronization.
JIRA_BASE_URL="https://your-company.atlassian.net"
JIRA_PROJECT_KEY="SUP"
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Document persistence drivers. Empty values select local/local in development
# and s3/postgresql in production.
DOCUMENT_STORAGE_DRIVER=""
DOCUMENT_METADATA_DRIVER=""
DOCUMENT_DATA_DIR=""

# S3-compatible private object storage for production attachments and documents.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET="avantime-attachments"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# One-time migration and cleanup commands. Legacy data is never deleted automatically.
LEGACY_DOCUMENT_DATA_DIR=""
MIGRATION_TENANT_ID="avantime"
CLEANUP_TENANT_ID="avantime"

# Local attachment storage (default: apps/web/.data/uploads)
UPLOAD_DIR=""

# Password reset email provider (planned; development exposes a local reset URL)
MAIL_FROM="support@avantime.lv"

RESEND_API_KEY=""
APP_URL="http://localhost:3000"

# Experimental AI providers. Leave empty when the corresponding route is unused.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
GOOGLE_GENERATIVE_AI_API_KEY=""
