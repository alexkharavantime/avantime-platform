# Required in every environment. Generate a unique value with at least 32 characters.
SESSION_SECRET=""

# Optional local-only demo login. It is always disabled in production.
ENABLE_DEMO_AUTH="false"

# PostgreSQL. Required for document metadata in production.
DATABASE_URL="postgresql://avantime:avantime@localhost:5432/avantime?schema=public"

# Jira Cloud. Leave credentials empty to run without Jira synchronization.
JIRA_BASE_URL="https://your-company.atlassian.net"
JIRA_PROJECT_KEY="SUP"
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Document persistence drivers. Empty values select local/local in development
# and s3/postgresql in production.
DOCUMENT_STORAGE_DRIVER=""
DOCUMENT_METADATA_DRIVER=""
DOCUMENT_DATA_DIR=""

# Document processing queue. Development defaults to a local persistent queue.
# Production requires an injected external adapter; a provider is not selected yet.
# Local PostgreSQL/MinIO validation uses the separate .env.integration.example.
DOCUMENT_PROCESSING_QUEUE_DRIVER=""
DOCUMENT_PROCESSING_QUEUE_NAME=""
DOCUMENT_PROCESSING_MAX_ATTEMPTS="3"
DOCUMENT_PROCESSING_INITIAL_RETRY_MS="1000"
DOCUMENT_PROCESSING_MAX_RETRY_MS="60000"
DOCUMENT_PROCESSING_LEASE_MS="300000"
DOCUMENT_PROCESSING_POLL_MS="1000"
DOCUMENT_WORKER_TENANT_ID=""
DOCUMENT_WORKER_ID=""
# Development defaults to disabled. Production requires an explicitly configured provider
# and cannot opt out of OCR readiness.
DOCUMENT_OCR_DRIVER="disabled"
DOCUMENT_OCR_REQUIRED_FOR_READINESS="false"
DOCUMENT_OCR_LANGUAGES="eng,rus,lav"
DOCUMENT_OCR_TIMEOUT_MS="120000"
DOCUMENT_OCR_MAX_PAGES="50"
DOCUMENT_OCR_MAX_FILE_SIZE="20971520"
DOCUMENT_TEXT_MIN_CHARACTERS="80"
DOCUMENT_TEXT_MIN_PRINTABLE_RATIO="0.90"
DOCUMENT_TEXT_MIN_ALPHANUMERIC_RATIO="0.20"
DOCUMENT_DETECTION_MIN_CONFIDENCE="0.70"
DOCUMENT_INTELLIGENCE_VERSION="document-intelligence-v1"

# Document embeddings, vector search and hybrid RAG. Development defaults use
# deterministic fake AI, an in-memory vector repository and a local persistent queue.
# Production requires explicit providers, PostgreSQL/pgvector and PostgreSQL jobs.
DOCUMENT_EMBEDDING_DRIVER="fake"
DOCUMENT_EMBEDDING_MODEL="deterministic-hash-v1"
DOCUMENT_EMBEDDING_DIMENSIONS="32"
DOCUMENT_EMBEDDING_VERSION="embedding-v1"
DOCUMENT_EMBEDDING_BATCH_SIZE="32"
DOCUMENT_EMBEDDING_TIMEOUT_MS="30000"
DOCUMENT_EMBEDDING_MAX_ATTEMPTS="3"
DOCUMENT_EMBEDDING_INITIAL_RETRY_MS="1000"
DOCUMENT_EMBEDDING_MAX_RETRY_MS="60000"
DOCUMENT_EMBEDDING_QUEUE_DRIVER="local"
DOCUMENT_EMBEDDING_LEASE_MS="300000"
DOCUMENT_EMBEDDING_POLL_MS="1000"
DOCUMENT_VECTOR_DRIVER="memory"
HYBRID_LEXICAL_WEIGHT="0.45"
HYBRID_SEMANTIC_WEIGHT="0.55"
HYBRID_TOP_K="12"
HYBRID_MAX_CHUNKS_PER_DOCUMENT="3"
HYBRID_MIN_SCORE="0.20"
SEMANTIC_SIMILARITY_THRESHOLD="0.25"
RAG_ANSWER_DRIVER="fake"
RAG_ANSWER_MODEL="gpt-5-mini"
RAG_MAX_CONTEXT_CHARACTERS="18000"
RAG_MAX_OUTPUT_TOKENS="1000"
RAG_TIMEOUT_MS="45000"
RAG_QUERY_MAX_CHARACTERS="2000"
AI_RATE_LIMIT_PER_MINUTE="30"
AI_DAILY_BUDGET_EUR="0"
DOCUMENT_RAG_REQUIRED_FOR_READINESS="false"

# S3-compatible private object storage for production attachments and documents.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_BUCKET="avantime-attachments"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# One-time migration and cleanup commands. Legacy data is never deleted automatically.
LEGACY_DOCUMENT_DATA_DIR=""
MIGRATION_TENANT_ID="avantime"
CLEANUP_TENANT_ID="avantime"

# Local attachment storage (default: apps/web/.data/uploads)
UPLOAD_DIR=""

# Password reset email provider (planned; development exposes a local reset URL)
MAIL_FROM="support@avantime.lv"

RESEND_API_KEY=""
APP_URL="http://localhost:3000"

# Experimental AI providers. Leave empty when the corresponding route is unused.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
GOOGLE_GENERATIVE_AI_API_KEY=""
