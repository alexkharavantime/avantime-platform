generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  role                   UserRole                @default(CLIENT)
  active                 Boolean                 @default(true)
  passwordHash           String?
  phone                  String?
  jobTitle               String?
  company                Company?                @relation(fields: [companyId], references: [id])
  companyId              String?
  requests               SupportRequest[]
  messages               RequestMessage[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  passwordResetTokens    PasswordResetToken[]
  notificationPreference NotificationPreference?
  emailMessages          EmailMessage[]
  knowledgeArticles      KnowledgeArticle[]
}

model Company {
  id                 String           @id @default(cuid())
  name               String
  registrationNumber String?
  address            String?
  users              User[]
  requests           SupportRequest[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model SupportRequest {
  id          String              @id @default(cuid())
  publicId    String              @unique
  title       String
  description String
  category    String
  priority    Priority            @default(NORMAL)
  status      RequestStatus       @default(NEW)
  jiraKey     String?
  jiraSyncAt  DateTime?
  dueAt       DateTime?
  requester   User                @relation(fields: [requesterId], references: [id])
  requesterId String
  company     Company             @relation(fields: [companyId], references: [id])
  companyId   String
  messages    RequestMessage[]
  auditEvents AuditEvent[]
  attachments RequestAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model RequestMessage {
  id        String         @id @default(cuid())
  body      String
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  createdAt DateTime       @default(now())
}

enum UserRole {
  CLIENT
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model AuditEvent {
  id        String         @id @default(cuid())
  action    String
  actorName String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  createdAt DateTime       @default(now())
}

model RequestAttachment {
  id         String         @id @default(cuid())
  name       String
  mimeType   String
  size       Int
  storageKey String
  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  createdAt  DateTime       @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model SystemEvent {
  id         String   @id @default(cuid())
  level      String   @default("INFO")
  category   String
  message    String
  actorEmail String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model NotificationPreference {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  requestCreated Boolean  @default(true)
  requestUpdated Boolean  @default(true)
  newMessage     Boolean  @default(true)
  slaAlerts      Boolean  @default(true)
  weeklySummary  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model EmailMessage {
  id          String      @id @default(cuid())
  recipient   String
  subject     String
  textBody    String
  htmlBody    String?
  template    String
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  providerId  String?
  scheduledAt DateTime    @default(now())
  sentAt      DateTime?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, scheduledAt])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model KnowledgeArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String
  category    String
  tags        String[]      @default([])
  readingTime String        @default("5 минут")
  content     Json
  status      ArticleStatus @default(DRAFT)
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DocumentMetadata {
  id                      String                       @db.VarChar(200)
  companyId               String                       @db.VarChar(200)
  uploadedBy              String                       @db.VarChar(200)
  originalName            String
  storedName              String                       @db.VarChar(255)
  mimeType                String                       @db.VarChar(255)
  size                    Int
  status                  DocumentProcessingStatus     @default(UPLOADED)
  checksum                String                       @db.VarChar(64)
  processingAttempts      Int                          @default(0)
  lastErrorCode           String?                      @db.VarChar(100)
  lastErrorMessage        String?
  processingStartedAt     DateTime?
  processingCompletedAt   DateTime?
  nextRetryAt             DateTime?
  quarantinedAt           DateTime?
  workerId                String?                      @db.VarChar(200)
  workerVersion           String?                      @db.VarChar(100)
  deploymentGeneration    String?                      @db.VarChar(100)
  processingFencingToken  Int                          @default(0)
  workerHeartbeatAt       DateTime?
  processingLeaseUntil    DateTime?
  pages                   Int?
  textLength              Int?
  chunksCount             Int?
  detectedDocumentType    DocumentType                 @default(UNKNOWN)
  detectedMimeType        String?                      @db.VarChar(255)
  detectionConfidence     Float?
  textExtractionMethod    DocumentTextExtractionMethod @default(NONE)
  ocrStatus               DocumentOcrStatus            @default(PENDING)
  ocrProvider             String?                      @db.VarChar(100)
  ocrLanguage             String?                      @db.VarChar(100)
  ocrStartedAt            DateTime?
  ocrCompletedAt          DateTime?
  pageCount               Int?
  extractedCharacterCount Int?
  requiresManualReview    Boolean                      @default(true)
  intelligenceVersion     String                       @default("document-intelligence-v1") @db.VarChar(100)
  embeddingStatus         DocumentEmbeddingStatus      @default(PENDING)
  embeddingModel          String?                      @db.VarChar(200)
  embeddingDimensions     Int?
  embeddingVersion        String?                      @db.VarChar(100)
  embeddedAt              DateTime?
  embeddingAttempts       Int                          @default(0)
  lastEmbeddingErrorCode  String?                      @db.VarChar(100)
  embeddingContentHash    String?                      @db.VarChar(64)
  embeddingWorkerId       String?                      @db.VarChar(200)
  embeddingWorkerVersion  String?                      @db.VarChar(100)
  embeddingDeploymentGeneration String?                @db.VarChar(100)
  embeddingFencingToken   Int                          @default(0)
  embeddingHeartbeatAt    DateTime?
  embeddingLeaseUntil     DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  deletedAt               DateTime?
  chunkEmbeddings         DocumentChunkEmbedding[]
  embeddingJob            DocumentEmbeddingJob?

  @@id([companyId, id])
  @@index([companyId, status])
  @@index([companyId, nextRetryAt])
  @@index([companyId, quarantinedAt])
  @@index([companyId, createdAt])
  @@index([companyId, detectedDocumentType])
  @@index([companyId, requiresManualReview])
  @@index([companyId, embeddingStatus])
  @@index([workerHeartbeatAt])
  @@index([embeddingHeartbeatAt])
  @@index([createdAt])
  @@index([deletedAt])
}

enum DocumentProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  QUARANTINED
  DELETED
}

enum DocumentType {
  INVOICE
  CREDIT_NOTE
  CONTRACT
  ACT
  ORDER
  DELIVERY_NOTE
  BANK_STATEMENT
  RECEIPT
  REPORT
  LETTER
  IMAGE
  UNKNOWN
}

enum DocumentTextExtractionMethod {
  PDF_TEXT
  OCR
  NONE
}

enum DocumentOcrStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNAVAILABLE
}

enum DocumentEmbeddingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  QUARANTINED
  DISABLED
}

enum DocumentEmbeddingJobStatus {
  QUEUED
  PROCESSING
}

model DocumentChunkEmbedding {
  companyId        String   @db.VarChar(200)
  documentId       String   @db.VarChar(200)
  chunkId          String   @db.VarChar(200)
  chunkIndex       Int
  contentHash      String   @db.VarChar(64)
  contentPreview   String
  pageStart        Int?
  pageEnd          Int?
  sourceSegmentIndex Int?
  extractionMethod String?  @db.VarChar(50)
  sourceCoordinates Json?
  provenanceConfidence Float?
  provenanceVersion String? @db.VarChar(50)
  embeddingModel   String   @db.VarChar(200)
  embeddingVersion String   @db.VarChar(100)
  dimensions       Int
  embedding        Unsupported("vector")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  document         DocumentMetadata @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, documentId, chunkId, embeddingModel, embeddingVersion])
  @@index([companyId, embeddingModel, embeddingVersion])
  @@index([companyId, documentId])
}

model DocumentEmbeddingJob {
  id          String                     @id @default(cuid()) @db.VarChar(200)
  companyId   String                     @db.VarChar(200)
  documentId  String                     @db.VarChar(200)
  correlationId String                   @default(cuid()) @db.VarChar(200)
  jobVersion  Int                        @default(1)
  status      DocumentEmbeddingJobStatus @default(QUEUED)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  leaseOwner  String?                    @db.VarChar(200)
  leaseUntil  DateTime?
  fencingToken Int                       @default(0)
  heartbeatAt DateTime?
  workerVersion String?                  @db.VarChar(100)
  deploymentGeneration String?           @db.VarChar(100)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  document    DocumentMetadata           @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, documentId])
  @@index([companyId, status, availableAt])
  @@index([leaseUntil])
  @@index([heartbeatAt])
}

model AiUsageLedger {
  id                 String   @id @default(cuid()) @db.VarChar(200)
  companyId          String   @db.VarChar(200)
  userId             String?  @db.VarChar(200)
  correlationId      String   @db.VarChar(200)
  idempotencyKey     String   @db.VarChar(250)
  requestType        String   @db.VarChar(50)
  provider           String   @db.VarChar(100)
  model              String   @db.VarChar(200)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  embeddingUnits     Int      @default(0)
  estimatedCostEur   Decimal  @default(0) @db.Decimal(18, 8)
  actualCostEur      Decimal? @db.Decimal(18, 8)
  currency           String   @default("EUR") @db.VarChar(3)
  status             String   @db.VarChar(30)
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, occurredAt])
  @@index([companyId, provider, occurredAt])
}

model AiBudgetPolicy {
  companyId          String   @id @db.VarChar(200)
  dailyLimitEur      Decimal  @db.Decimal(18, 8)
  monthlyLimitEur    Decimal  @db.Decimal(18, 8)
  providerLimits     Json?
  warningThreshold   Float    @default(0.8)
  hardStopThreshold  Float    @default(1)
  updatedBy          String?  @db.VarChar(200)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedAt])
}

model AiBudgetReservation {
  id                 String   @id @default(cuid()) @db.VarChar(200)
  companyId          String   @db.VarChar(200)
  userId             String?  @db.VarChar(200)
  provider           String   @db.VarChar(100)
  correlationId      String   @db.VarChar(200)
  idempotencyKey     String   @db.VarChar(250)
  estimatedCostEur   Decimal  @db.Decimal(18, 8)
  currency           String   @default("EUR") @db.VarChar(3)
  status             String   @db.VarChar(30)
  expiresAt          DateTime
  reconciledAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId, status, expiresAt])
  @@index([companyId, provider, status])
}

model ProductionAuditEvent {
  id                 String   @id @default(cuid()) @db.VarChar(200)
  companyId          String?  @db.VarChar(200)
  actorId            String?  @db.VarChar(200)
  action             String   @db.VarChar(100)
  targetType         String   @db.VarChar(100)
  targetId           String?  @db.VarChar(200)
  result             String   @db.VarChar(30)
  correlationId      String   @db.VarChar(200)
  safeMetadata       Json?
  previousState      Json?
  newState           Json?
  occurredAt         DateTime @default(now())

  @@index([companyId, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
}

model RecoveryOperation {
  id                 String   @id @default(cuid()) @db.VarChar(200)
  operationType      String   @db.VarChar(50)
  environment        String   @db.VarChar(50)
  status             String   @db.VarChar(30)
  checksum           String?  @db.VarChar(128)
  objectCount        Int?
  databaseBackupAt   DateTime?
  objectBackupAt     DateTime?
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  safeDetails        Json?

  @@index([operationType, status, startedAt])
}
