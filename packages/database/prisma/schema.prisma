generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                       @id @default(cuid())
  email                     String
  emailNormalized           String
  emailVerifiedAt           DateTime?
  name                      String
  role                      UserRole                     @default(CLIENT)
  active                    Boolean                      @default(true)
  disabledAt                DateTime?
  // Compatibility-only field. New local passwords are stored in UserCredential.
  passwordHash              String?
  phone                     String?
  jobTitle                  String?
  company                   Company?                     @relation(fields: [companyId], references: [id])
  companyId                 String?
  memberships               OrganizationMembership[]
  credentials               UserCredential[]
  externalIdentities        ExternalIdentity[]
  oidcAuthorizationRequests OidcAuthorizationRequest[]
  invitationsSent           IdentityInvitation[]         @relation("IdentityInvitationInviter")
  invitationsAccepted       IdentityInvitation[]         @relation("IdentityInvitationAccepter")
  sessions                  UserSession[]
  loginChallenges           LoginChallenge[]
  mfaMethods                MfaMethod[]
  recoveryCodes             RecoveryCode[]
  emailVerificationTokens   EmailVerificationToken[]
  securityEvents            SecurityEvent[]
  mfaExemptions             OrganizationMfaExemption[]
  requests                  SupportRequest[]
  messages                  RequestMessage[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  passwordResetTokens       PasswordResetToken[]
  notificationPreference    NotificationPreference?
  emailMessages             EmailMessage[]
  knowledgeArticles         KnowledgeArticle[]
  portalNotifications       PortalNotification[]
  platformRoleAssignments   PlatformRoleAssignment[]     @relation("PlatformRoleAssignee")
  platformRolesAssigned     PlatformRoleAssignment[]     @relation("PlatformRoleAssigner")
  supportSessions           PlatformSupportSession[]     @relation("PlatformSupportActor")
  supportSessionsEnded      PlatformSupportSession[]     @relation("PlatformSupportEnder")
  approvalRequests          GovernanceApprovalRequest[]  @relation("ApprovalRequester")
  approvalDecisions         GovernanceApprovalDecision[] @relation("ApprovalApprover")
  governanceNotifications   GovernanceNotification[]
  platformOwnerBootstraps   PlatformOwnerBootstrap[]

  @@index([emailNormalized])
}

model Company {
  id                      String                      @id @default(cuid())
  name                    String
  registrationNumber      String?
  address                 String?
  users                   User[]
  memberships             OrganizationMembership[]
  identityPolicy          OrganizationIdentityPolicy?
  identityProviders       IdentityProvider[]
  identityInvitations     IdentityInvitation[]
  requests                SupportRequest[]
  portalNotifications     PortalNotification[]
  knowledgeArticles       KnowledgeArticle[]
  supportSessions         PlatformSupportSession[]
  approvalRequests        GovernanceApprovalRequest[]
  governanceNotifications GovernanceNotification[]
  jiraMapping             JiraOrganizationMapping?
  jiraOperations          JiraOperation[]
  jiraInboundEvents       JiraInboundEvent[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
}

model OrganizationMembership {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  // Compatibility field retained during the CLIENT/ADMIN migration period.
  role             UserRole         @default(CLIENT)
  organizationRole OrganizationRole @default(MEMBER)
  status           MembershipStatus @default(ACTIVE)
  version          Int              @default(1)
  active           Boolean          @default(true)
  suspendedAt      DateTime?
  removedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, active])
  @@index([companyId, status, organizationRole])
  @@index([userId, active])
  @@index([userId, status])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_AUDITOR
  PLATFORM_OPERATOR
}

model PlatformRoleAssignment {
  id           String       @id @default(cuid())
  user         User         @relation("PlatformRoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  role         PlatformRole
  active       Boolean      @default(true)
  version      Int          @default(1)
  assignedBy   User?        @relation("PlatformRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, role])
  @@index([userId, active])
  @@index([role, active])
}

model PlatformOwnerBootstrap {
  id                     String   @id @default(cuid())
  singletonKey           String   @unique @db.VarChar(50)
  authorizationId        String   @unique @db.VarChar(200)
  authorizationHash      String   @unique @db.VarChar(64)
  environment            String   @db.VarChar(30)
  targetUser             User     @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  targetUserId           String
  sessionEvidenceHash    String   @db.VarChar(64)
  mfaEventEvidenceId     String   @db.VarChar(200)
  authorizationExpiresAt DateTime
  assignmentId           String   @unique @db.VarChar(200)
  auditEventId            String   @unique @db.VarChar(200)
  notificationId         String   @unique @db.VarChar(200)
  executedAt             DateTime
  createdAt              DateTime @default(now())

  @@index([targetUserId, executedAt])
}

model PlatformSupportSession {
  id              String    @id @default(cuid())
  actor           User      @relation("PlatformSupportActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId         String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyId       String
  reasonCode      String    @db.VarChar(100)
  ticketReference String    @db.VarChar(200)
  allowedScopes   Json
  mfaVerifiedAt   DateTime
  authenticatedAt DateTime
  expiresAt       DateTime
  endedAt         DateTime?
  endedBy         User?     @relation("PlatformSupportEnder", fields: [endedById], references: [id], onDelete: SetNull)
  endedById       String?
  createdAt       DateTime  @default(now())

  @@index([actorId, expiresAt, endedAt])
  @@index([companyId, expiresAt, endedAt])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum IdentityProviderKind {
  LOCAL
  OIDC
  SAML
}

enum OidcProviderProfile {
  MICROSOFT_ENTRA_ID
  GOOGLE_WORKSPACE
  GENERIC_OIDC
}

enum OidcOrganizationMappingMode {
  STATIC
  PROVIDER_TENANT_CLAIM
  HOSTED_DOMAIN
  CLAIM
}

enum OidcProviderValidationStatus {
  NOT_VALIDATED
  METADATA_VALIDATED
  TENANT_VALIDATED
  REVALIDATION_REQUIRED
  FAILED
}

enum OidcProviderSessionPolicy {
  PRESERVE_EXISTING
  REVOKE_ON_DISABLE
}

enum OidcAuthorizationPurpose {
  LOGIN
  LINK
  PROVIDER_VALIDATION
}

model IdentityProvider {
  id                       String                       @id @default(cuid())
  key                      String                       @unique
  kind                     IdentityProviderKind
  oidcProfile              OidcProviderProfile?
  displayName              String
  company                  Company?                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId                String?
  issuer                   String?
  clientId                 String?
  clientSecretRefEncrypted String?
  secretKeyVersion         String?
  discoveryUrl             String?
  authorizationEndpoint    String?
  tokenEndpoint            String?
  jwksUri                  String?
  redirectUri              String?
  redirectUris             Json?
  allowedDomains           Json?
  organizationMappingMode  OidcOrganizationMappingMode  @default(STATIC)
  tenantMappingPolicy      Json?
  claimMapping             Json?
  groupRoleMapping         Json?
  defaultRole              UserRole                     @default(CLIENT)
  sessionPolicy            OidcProviderSessionPolicy    @default(REVOKE_ON_DISABLE)
  metadataRefreshedAt      DateTime?
  metadataExpiresAt        DateTime?
  validationStatus         OidcProviderValidationStatus @default(NOT_VALIDATED)
  validationEvidenceRef    String?
  createdBy                String?
  updatedBy                String?
  configurationVersion     Int                          @default(1)
  enabled                  Boolean                      @default(false)
  externalIdentities       ExternalIdentity[]
  authorizationRequests    OidcAuthorizationRequest[]
  tokenReplays             OidcTokenReplay[]
  sessions                 UserSession[]
  loginChallenges          LoginChallenge[]
  ssoPolicies              OrganizationIdentityPolicy[] @relation("OrganizationSsoProvider")
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([id, companyId])
  @@index([companyId, enabled])
  @@index([kind, enabled])
}

model ExternalIdentity {
  id                  String           @id @default(cuid())
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  provider            IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerId          String
  subject             String
  emailNormalized     String?
  emailVerified       Boolean          @default(false)
  lastAuthenticatedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([providerId, subject])
  @@index([userId])
  @@index([providerId, emailNormalized])
}

model OidcAuthorizationRequest {
  id                    String                   @id @default(cuid())
  provider              IdentityProvider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId            String
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String?
  purpose               OidcAuthorizationPurpose @default(LOGIN)
  stateHash             String                   @unique @db.VarChar(64)
  nonceHash             String                   @db.VarChar(64)
  pkceVerifierEncrypted String
  redirectUri           String
  returnTo              String?
  expiresAt             DateTime
  consumedAt            DateTime?
  validatedAt           DateTime?
  createdAt             DateTime                 @default(now())

  @@index([providerId, expiresAt])
  @@index([userId, expiresAt])
}

model OidcTokenReplay {
  id          String           @id @default(cuid())
  provider    IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String
  tokenIdHash String           @db.VarChar(64)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@unique([providerId, tokenIdHash])
  @@index([expiresAt])
}

enum CredentialKind {
  PASSWORD
}

model UserCredential {
  id                   String         @id @default(cuid())
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  kind                 CredentialKind @default(PASSWORD)
  identifierNormalized String         @unique
  passwordHash         String
  passwordChangedAt    DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([userId, kind])
  @@index([updatedAt])
}

model UserSession {
  id                 String            @id @default(cuid())
  tokenHash          String            @unique @db.VarChar(64)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  companyId          String?
  identityProvider   IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: SetNull)
  identityProviderId String?
  createdAt          DateTime          @default(now())
  lastActivityAt     DateTime          @default(now())
  expiresAt          DateTime
  idleExpiresAt      DateTime
  revokedAt          DateTime?
  rotatedFromId      String?
  deviceLabel        String?           @db.VarChar(120)
  authenticationAt   DateTime          @default(now())

  @@index([userId, revokedAt, expiresAt])
  @@index([identityProviderId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model LoginChallenge {
  id                 String            @id @default(cuid())
  tokenHash          String            @unique @db.VarChar(64)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  companyId          String?
  identityProvider   IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: Cascade)
  identityProviderId String?
  redirectTo         String?
  attempts           Int               @default(0)
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime          @default(now())

  @@index([userId, expiresAt])
  @@index([identityProviderId, expiresAt])
  @@index([expiresAt])
}

enum MfaMethodKind {
  TOTP
  WEBAUTHN
  IDP_CLAIM
}

enum MfaMethodStatus {
  PENDING
  ACTIVE
  DISABLED
}

model MfaMethod {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  kind            MfaMethodKind
  status          MfaMethodStatus @default(PENDING)
  label           String?         @db.VarChar(120)
  secretEncrypted String?
  lastUsedCounter Int?
  confirmedAt     DateTime?
  disabledAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, status])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  batchId   String    @db.VarChar(100)
  codeHash  String    @unique @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, batchId, usedAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  redirectTo String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model IdentityInvitation {
  id               String           @id @default(cuid())
  tokenHash        String           @unique @db.VarChar(64)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  emailNormalized  String
  // Legacy role is retained for backwards-compatible invitation reads.
  role             UserRole         @default(CLIENT)
  organizationRole OrganizationRole @default(MEMBER)
  inviter          User             @relation("IdentityInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  invitedBy        String
  accepter         User?            @relation("IdentityInvitationAccepter", fields: [acceptedBy], references: [id], onDelete: SetNull)
  acceptedBy       String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([companyId, emailNormalized, revokedAt, acceptedAt])
  @@index([invitedBy, createdAt])
  @@index([expiresAt])
}

enum SecurityEventResult {
  SUCCEEDED
  FAILED
  DENIED
}

model SecurityEvent {
  id            String              @id @default(cuid())
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  companyId     String?
  action        String              @db.VarChar(100)
  result        SecurityEventResult
  correlationId String              @db.VarChar(200)
  safeMetadata  Json?
  createdAt     DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

enum OrganizationMfaRequirement {
  OPTIONAL
  ADMINS
  ALL_MEMBERS
}

enum OrganizationSsoRequirement {
  DISABLED
  OPTIONAL
  REQUIRED
}

model OrganizationIdentityPolicy {
  company              Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            String                     @id
  mfaRequirement       OrganizationMfaRequirement @default(OPTIONAL)
  gracePeriodDays      Int                        @default(0)
  enforcementAt        DateTime?
  ssoRequirement       OrganizationSsoRequirement @default(DISABLED)
  ssoProvider          IdentityProvider?          @relation("OrganizationSsoProvider", fields: [ssoProviderId, companyId], references: [id, companyId], onDelete: Restrict)
  ssoProviderId        String?
  ssoEnforcementAt     DateTime?
  ssoGracePeriodDays   Int                        @default(0)
  localLoginAllowed    Boolean                    @default(true)
  configurationVersion Int                        @default(1)
  updatedBy            String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  exemptions           OrganizationMfaExemption[]
}

model OrganizationMfaExemption {
  id         String                     @id @default(cuid())
  policy     OrganizationIdentityPolicy @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  companyId  String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  reasonCode String                     @db.VarChar(100)
  expiresAt  DateTime
  approvedBy String                     @db.VarChar(200)
  createdAt  DateTime                   @default(now())

  @@unique([companyId, userId])
  @@index([expiresAt])
}

model SupportRequest {
  id                    String                @id @default(cuid())
  publicId              String                @unique
  title                 String
  description           String
  category              String
  priority              Priority              @default(NORMAL)
  status                RequestStatus         @default(NEW)
  jiraIntegrationStatus JiraIntegrationStatus @default(NOT_CONFIGURED)
  version               Int                   @default(1)
  jiraIssueId           String?               @unique @db.VarChar(200)
  jiraKey               String?               @unique @db.VarChar(100)
  jiraIssueUrl          String?               @db.VarChar(500)
  jiraSyncAt            DateTime?
  jiraStatusId          String?               @db.VarChar(100)
  jiraStatusName        String?               @db.VarChar(160)
  jiraUpdatedAt         DateTime?
  jiraSyncVersion       Int                   @default(0)
  correlationId         String?               @db.VarChar(200)
  idempotencyKey        String?               @unique @db.VarChar(200)
  dueAt                 DateTime?
  requester             User                  @relation(fields: [requesterId], references: [id])
  requesterId           String
  company               Company               @relation(fields: [companyId], references: [id])
  companyId             String
  jiraOperations        JiraOperation[]
  jiraInboundEvents     JiraInboundEvent[]
  messages              RequestMessage[]
  auditEvents           AuditEvent[]
  attachments           RequestAttachment[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([companyId, jiraIntegrationStatus, createdAt])
  @@index([correlationId])
}

enum JiraIntegrationStatus {
  NOT_CONFIGURED
  PENDING
  PROCESSING
  CREATED
  FAILED
  DEAD_LETTER
}

model JiraOrganizationMapping {
  id            String          @id @default(cuid())
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String          @unique
  projectKey    String          @db.VarChar(50)
  issueType     String?         @db.VarChar(100)
  componentId   String?         @db.VarChar(100)
  requestType   String?         @db.VarChar(100)
  statusMapping Json?
  enabled       Boolean         @default(false)
  version       Int             @default(1)
  operations    JiraOperation[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([enabled, updatedAt])
}

enum JiraOperationType {
  CREATE_ISSUE
  ADD_COMMENT
}

enum JiraOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model JiraOperation {
  id                String                  @id @default(cuid())
  request           SupportRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requestId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyId         String
  mapping           JiraOrganizationMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  mappingId         String
  mappingVersion    Int
  operationType     JiraOperationType       @default(CREATE_ISSUE)
  status            JiraOperationStatus     @default(PENDING)
  attempts          Int                     @default(0)
  maxAttempts       Int                     @default(5)
  nextAttemptAt     DateTime                @default(now())
  leaseToken        String?                 @db.VarChar(100)
  leaseUntil        DateTime?
  idempotencyKey    String                  @unique @db.VarChar(200)
  correlationId     String                  @db.VarChar(200)
  projectKey        String                  @db.VarChar(50)
  issueType         String                  @db.VarChar(100)
  componentId       String?                 @db.VarChar(100)
  requestType       String?                 @db.VarChar(100)
  localComment      RequestMessage?         @relation(fields: [localCommentId], references: [id], onDelete: Restrict)
  localCommentId    String?                 @unique
  providerIssueId   String?                 @unique @db.VarChar(200)
  providerIssueKey  String?                 @unique @db.VarChar(100)
  providerCommentId String?                 @unique @db.VarChar(200)
  lastFailureCode   String?                 @db.VarChar(100)
  completedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([companyId, status, createdAt])
  @@index([requestId, operationType, createdAt])
  @@index([correlationId])
}

enum JiraInboundEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  IGNORED
  FAILED
  DEAD_LETTER
}

model JiraInboundEvent {
  id                String                 @id @default(cuid())
  providerEventId   String?                @db.VarChar(200)
  eventFingerprint  String                 @unique @db.VarChar(64)
  eventType         String                 @db.VarChar(100)
  jiraTenantOrigin  String                 @db.VarChar(300)
  jiraIssueId       String                 @db.VarChar(200)
  jiraIssueKey      String                 @db.VarChar(100)
  request           SupportRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId         String
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String
  payloadVersion    Int                    @default(1)
  normalizedPayload Json
  occurredAt        DateTime
  receivedAt        DateTime               @default(now())
  status            JiraInboundEventStatus @default(PENDING)
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(5)
  nextAttemptAt     DateTime               @default(now())
  leaseToken        String?                @db.VarChar(100)
  leaseUntil        DateTime?
  lastFailureCode   String?                @db.VarChar(100)
  correlationId     String                 @db.VarChar(200)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([jiraTenantOrigin, providerEventId])
  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([companyId, status, createdAt])
  @@index([requestId, occurredAt])
  @@index([correlationId])
  @@index([receivedAt])
}

model JiraInboundWorkerHeartbeat {
  workerId             String   @id @db.VarChar(100)
  workerVersion        String   @db.VarChar(100)
  deploymentGeneration String   @db.VarChar(100)
  status               String   @db.VarChar(30)
  lastBatchSize        Int      @default(0)
  lastErrorCode        String?  @db.VarChar(100)
  heartbeatAt          DateTime @default(now())
  startedAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model JiraWorkerHeartbeat {
  workerId             String   @id @db.VarChar(100)
  workerVersion        String   @db.VarChar(100)
  deploymentGeneration String   @db.VarChar(100)
  status               String   @db.VarChar(30)
  lastBatchSize        Int      @default(0)
  lastErrorCode        String?  @db.VarChar(100)
  heartbeatAt          DateTime @default(now())
  startedAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RequestMessage {
  id                   String                       @id @default(cuid())
  body                 String
  author               User?                        @relation(fields: [authorId], references: [id])
  authorId             String?
  authorType           RequestMessageAuthorType     @default(CUSTOMER)
  authorDisplayName    String?                      @db.VarChar(160)
  deliveryStatus       RequestMessageDeliveryStatus @default(NOT_REQUIRED)
  request              SupportRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId            String
  jiraCommentId        String?                      @unique @db.VarChar(200)
  jiraCommentUpdatedAt DateTime?
  idempotencyKey       String?                      @unique @db.VarChar(200)
  correlationId        String?                      @db.VarChar(200)
  jiraOperation        JiraOperation?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([requestId, createdAt])
  @@index([deliveryStatus, updatedAt])
}

enum RequestMessageAuthorType {
  CUSTOMER
  AVANTIME
  JIRA
  SYSTEM
}

enum RequestMessageDeliveryStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum UserRole {
  CLIENT
  ADMIN
}

enum RequestStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model AuditEvent {
  id        String         @id @default(cuid())
  action    String
  actorName String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  createdAt DateTime       @default(now())
}

model RequestAttachment {
  id         String         @id @default(cuid())
  name       String
  mimeType   String
  size       Int
  storageKey String
  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
