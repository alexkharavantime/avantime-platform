model KnowledgeArticle {
  id                     String              @id @default(cuid())
  slug                   String              @unique
  title                  String
  summary                String
  category               String
  tags                   String[]            @default([])
  readingTime            String              @default("5 минут")
  content                Json
  status                 ArticleStatus       @default(DRAFT)
  author                 User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId               String?
  company                Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyId              String?
  ownerScope             KnowledgeOwnerScope
  visibility             KnowledgeVisibility
  version                Int                 @default(1)
  classificationEvidence String              @db.VarChar(200)
  publicationApproval     GovernanceApprovalRequest? @relation(fields: [publicationApprovalId], references: [id], onDelete: Restrict)
  publicationApprovalId   String?             @unique
  quarantinedAt          DateTime?
  publishedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status, visibility, category])
  @@index([companyId, status, visibility])
  @@index([ownerScope, status])
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeOwnerScope {
  PLATFORM
  ORGANIZATION
  SYSTEM
  LEGACY_UNCLASSIFIED
}

enum KnowledgeVisibility {
  PRIVATE
  ORGANIZATION
  PLATFORM
  PUBLIC
}

enum GovernanceApprovalActionType {
  PLATFORM_OWNER_ASSIGN
  PLATFORM_OWNER_REMOVE
  ORGANIZATION_LAST_OWNER_TRANSFER
  ORGANIZATION_REQUIRED_SSO_EMERGENCY_DISABLE
  ORGANIZATION_BREAK_GLASS_DISABLE
  IDENTITY_PROVIDER_DELETE
  PLATFORM_AUDIT_EXPORT
  ORGANIZATION_AUDIT_EXPORT
  BULK_TENANT_EXPORT
  KNOWLEDGE_VISIBILITY_PUBLIC
  CROSS_TENANT_SUPPORT_DESTRUCTIVE_ACTION
}

enum GovernanceApprovalScope {
  PLATFORM
  ORGANIZATION
}

enum GovernanceApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  CANCELLED
}

model GovernanceApprovalRequest {
  id                 String                       @id @default(cuid())
  actionType         GovernanceApprovalActionType
  scope              GovernanceApprovalScope
  company            Company?                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyId          String?
  resourceId         String?                      @db.VarChar(200)
  expectedVersion    Int?
  safeParameters     Json
  payloadFingerprint String                       @unique @db.VarChar(64)
  requester          User                         @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterId        String
  status             GovernanceApprovalStatus     @default(REQUESTED)
  expiresAt          DateTime
  executedAt         DateTime?
  cancelledAt        DateTime?
  executionKey       String?                      @unique @db.VarChar(200)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  decisions          GovernanceApprovalDecision[]
  publishedArticle   KnowledgeArticle?

  @@index([scope, companyId, status, expiresAt])
  @@index([requesterId, status, createdAt])
}

model GovernanceApprovalDecision {
  id         String                    @id @default(cuid())
  request    GovernanceApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  approver   User                      @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  approverId String
  approved   Boolean
  createdAt  DateTime                  @default(now())

  @@unique([requestId, approverId])
  @@index([approverId, createdAt])
}

model GovernanceNotification {
  id          String    @id @default(cuid())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
