  category    String    @db.VarChar(50)
  title       String    @db.VarChar(160)
  href        String    @db.VarChar(250)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([companyId, createdAt])
}

