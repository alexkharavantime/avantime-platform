{
  "name": "avantime-platform",
  "version": "1.5.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "npm run test:integration -w @avantime/web",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @avantime/database",
    "db:migrate": "npm run db:migrate -w @avantime/database",
    "db:seed": "npm run db:seed -w @avantime/database",
    "integration:up": "docker compose --env-file .env.integration -p avantime-integration -f docker-compose.integration.yml up -d --wait",
    "integration:down": "docker compose --env-file .env.integration -p avantime-integration -f docker-compose.integration.yml down --volumes --remove-orphans",
    "integration:clean": "npm run documents:integration-clean -w @avantime/web",
    "documents:migration-rehearsal": "npm run documents:migration-rehearsal -w @avantime/web",
    "documents:health-check": "npm run documents:health-check -w @avantime/web",
    "documents:health-check:integration": "npm run documents:health-check -w @avantime/web -- --integration",
    "documents:worker-check": "npm run documents:worker-check -w @avantime/web",
    "documents:worker-check:integration": "npm run documents:worker-check -w @avantime/web -- --integration",
    "documents:ocr-check": "npm run documents:ocr-check -w @avantime/web",
    "documents:intelligence-health": "npm run documents:intelligence-health -w @avantime/web",
    "documents:reprocess": "npm run documents:reprocess -w @avantime/web --",
    "test:ocr-integration": "npm run test:ocr-integration -w @avantime/web",
    "test:ocr-integration:docker": "docker build -f docker/ocr-integration.Dockerfile -t avantime-ocr-integration . && docker run --rm avantime-ocr-integration"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.26.0"
  }
}
