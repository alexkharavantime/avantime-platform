{
  "name": "avantime-platform",
  "version": "1.5.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "npm run test:integration -w @avantime/web",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @avantime/database",
    "db:migrate": "npm run db:migrate -w @avantime/database",
    "db:seed": "npm run db:seed -w @avantime/database",
    "integration:up": "docker compose --env-file .env.integration -p avantime-integration -f docker-compose.integration.yml up -d --wait postgres minio redis && docker compose --env-file .env.integration -p avantime-integration -f docker-compose.integration.yml run --rm minio-init",
    "integration:down": "docker compose --env-file .env.integration -p avantime-integration -f docker-compose.integration.yml down --volumes --remove-orphans",
    "integration:clean": "npm run documents:integration-clean -w @avantime/web",
    "documents:migration-rehearsal": "npm run documents:migration-rehearsal -w @avantime/web",
    "documents:health-check": "npm run documents:health-check -w @avantime/web",
    "documents:health-check:integration": "npm run documents:health-check -w @avantime/web -- --integration",
    "documents:worker-check": "npm run documents:worker-check -w @avantime/web",
    "documents:worker-check:integration": "npm run documents:worker-check -w @avantime/web -- --integration",
    "documents:ocr-check": "npm run documents:ocr-check -w @avantime/web",
    "documents:intelligence-health": "npm run documents:intelligence-health -w @avantime/web",
    "documents:reprocess": "npm run documents:reprocess -w @avantime/web --",
    "test:ocr-integration": "npm run test:ocr-integration -w @avantime/web",
    "test:ocr-integration:docker": "docker build -f docker/ocr-integration.Dockerfile -t avantime-ocr-integration . && docker run --rm avantime-ocr-integration",
    "documents:embedding-check": "npm run documents:embedding-check -w @avantime/web --",
    "documents:embedding-check:integration": "npm run documents:embedding-check -- --integration",
    "documents:vector-check": "npm run documents:vector-check -w @avantime/web --",
    "documents:vector-check:integration": "npm run documents:vector-check -- --integration",
    "documents:reindex": "npm run documents:reindex -w @avantime/web --",
    "documents:embedding-worker": "npm run documents:embedding-worker -w @avantime/web",
    "documents:embedding-process-one": "npm run documents:embedding-process-one -w @avantime/web",
    "documents:rag-evaluate": "npm run documents:rag-evaluate -w @avantime/web",
    "documents:rag-health-check": "npm run documents:rag-health-check -w @avantime/web",
    "test:rag-integration": "npm run test:rag-integration -w @avantime/web",
    "test:production-integration": "npm run test:production-integration -w @avantime/web",
    "production:config-check": "npm run production:config-check -w @avantime/web",
    "queue:health-check": "npm run queue:health-check -w @avantime/web",
    "workers:heartbeat-check": "npm run workers:heartbeat-check -w @avantime/web",
    "ai:cost-report": "npm run ai:cost-report -w @avantime/web --",
    "ai:budget-check": "npm run ai:budget-check -w @avantime/web",
    "backup:dry-run": "npm run backup:dry-run -w @avantime/web --",
    "backup:create": "npm run backup:create -w @avantime/web --",
    "backup:objects": "npm run backup:objects -w @avantime/web --",
    "backup:status": "npm run backup:status -w @avantime/web",
    "restore:rehearsal": "npm run restore:rehearsal -w @avantime/web --",
    "restore:rehearsal:integration": "npm run restore:rehearsal:integration -w @avantime/web",
    "pgvector:load-test": "npm run pgvector:load-test -w @avantime/web --",
    "production:readiness": "npm run production:readiness -w @avantime/web",
    "security:dependency-review": "npm audit --omit=optional",
    "security:secret-scan": "npm run security:secret-scan -w @avantime/web",
    "security:migration-scan": "npm run security:migration-scan -w @avantime/web",
    "security:architecture-scan": "npm run security:architecture-scan -w @avantime/web",
    "security:dependency-revalidation": "npm run security:dependency-revalidation -w @avantime/web",
    "security:container-policy": "npm run security:container-policy -w @avantime/web --",
    "test:container-policy": "npm run test:container-policy -w @avantime/web",
    "docs:links-check": "npm run docs:links-check -w @avantime/web",
    "staging:config-check": "npm run staging:config-check -w @avantime/web --",
    "staging:compose-check": "npm run staging:compose-check -w @avantime/web --",
    "staging:deploy:plan": "npm run staging:deploy:plan -w @avantime/web --",
    "staging:deploy": "npm run staging:deploy -w @avantime/web --",
    "staging:migrate": "npm run staging:migrate -w @avantime/web --",
    "staging:tls-check": "npm run staging:tls-check -w @avantime/web --",
    "staging:provider-check": "npm run staging:provider-check -w @avantime/web --",
    "staging:alert-test": "npm run staging:alert-test -w @avantime/web --",
    "staging:backup": "npm run staging:backup -w @avantime/web --",
    "staging:restore-rehearsal": "npm run staging:restore-rehearsal -w @avantime/web --",
    "staging:readiness": "npm run staging:readiness -w @avantime/web --",
    "staging:evidence": "npm run staging:evidence -w @avantime/web --",
    "staging:evidence:validate": "npm run staging:evidence:validate -w @avantime/web --",
    "staging:dataset": "npm run staging:dataset -w @avantime/web",
    "staging:smoke": "npm run staging:smoke -w @avantime/web --",
    "staging:load-smoke": "npm run staging:load-smoke -w @avantime/web --",
    "staging:sbom": "npm run staging:sbom -w @avantime/web",
    "staging:image-scan": "npm run staging:image-scan -w @avantime/web",
    "staging:images:verify": "npm run staging:images:verify -w @avantime/web",
    "staging:images:build": "docker buildx bake -f docker/production-bake.hcl",
    "staging:images:build:no-cache": "docker buildx bake -f docker/production-bake.hcl --pull --no-cache"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.26.0"
  }
}
